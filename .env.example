# Copy to .env for local scripts. Never commit the real .env.
# In n8n these live in Credentials, not in files.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=           # browser / Lovable only
SUPABASE_SERVICE_ROLE_KEY=   # n8n only - full database access, keep secret

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

N8N_WEBHOOK_URL=https://YOUR-N8N/webhook/silent-witness-brain
N8N_WEBHOOK_SECRET=          # same value in n8n Header Auth and the Supabase Database Webhook
